DATABASE_URL=sqlite:///./company_search.db
COLLECTION_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=false
# Optional dotted module:callable override returning app.ingestion.runtime.RuntimeComponents.
# Leave empty to use the checked-in settings-backed production composition.
COLLECTION_RUNTIME_FACTORY=
ZHIHU_PROVIDER_ENABLED=false
ZHIHU_ACCESS_SECRET=
# Required by the default runtime when collection is enabled.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
# Enable only with an exact operator-approved hostname allowlist.
COMPANY_SITE_PROVIDER_ENABLED=false
COMPANY_SITE_APPROVED_HOSTS=
PROVIDER_MAX_CONCURRENCY=2
PROVIDER_MIN_INTERVAL_SECONDS=0.25
# Beat runs reconciliation every minute using these age thresholds.
COLLECTION_STALE_QUEUED_SECONDS=300
COLLECTION_STALE_RUNNING_SECONDS=1800
