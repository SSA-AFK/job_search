DATABASE_URL=sqlite:///./company_search.db
COLLECTION_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=false
# Dotted module:callable returning RuntimeComponents(providers, extractor, semantic_judge).
# The worker creates and closes the three distinct database sessions.
COLLECTION_RUNTIME_FACTORY=
ZHIHU_PROVIDER_ENABLED=false
ZHIHU_ACCESS_SECRET=
# Runtime-factory settings for an OpenAI-compatible LLM client.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
# Enable only for explicitly authorized company websites; the factory must supply the website.
COMPANY_SITE_PROVIDER_ENABLED=false
