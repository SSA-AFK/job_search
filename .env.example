DATABASE_URL=sqlite:///./company_ranking_pilot_v2.sqlite3
COLLECTION_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=false
# Optional dotted module:callable override returning app.ingestion.runtime.RuntimeComponents.
# Leave empty to use the checked-in settings-backed production composition.
COLLECTION_RUNTIME_FACTORY=
ZHIHU_PROVIDER_ENABLED=false
ZHIHU_ACCESS_SECRET=
# Required by the default runtime when collection is enabled.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
# Enable only with an exact operator-approved hostname allowlist.
COMPANY_SITE_PROVIDER_ENABLED=false
COMPANY_SITE_APPROVED_HOSTS=
PROVIDER_MAX_CONCURRENCY=2
PROVIDER_MIN_INTERVAL_SECONDS=0.25
# Beat runs reconciliation every minute using these age thresholds.
COLLECTION_STALE_QUEUED_SECONDS=300
COLLECTION_STALE_RUNNING_SECONDS=1800
# Gate 1 manifest commands are offline unless both this flag and --live are set.
GATE1_LIVE_DISCOVERY_ENABLED=false
GATE1_SOURCE_REGISTRY_PATH=data/gate1/source_registry.json
GATE1_ZHIHU_REQUEST_BUDGET=200
GATE1_DOMAIN_MIN_INTERVAL_SECONDS=1.0
# External job enumeration is opt-in. Use an absolute path to a user-installed,
# pinned JobHunt-CLI executable; the application never installs or updates it.
JOBHUNT_ENABLED=false
JOBHUNT_EXECUTABLE=
JOBHUNT_EXPECTED_VERSION=0.2.4
JOBHUNT_SITE_REGISTRY_PATH=data/jobhunt_sites.json
JOBHUNT_TIMEOUT_SECONDS=60
JOB_FRESHNESS_HOURS=24
